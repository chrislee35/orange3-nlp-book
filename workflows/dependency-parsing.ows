		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'savedWidgetGeometry': None, 'selected_framework': 'spaCy', '__version__': 1}</properties>
		<properties node_id="9" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': None, 'scriptLibrary': [{'name': 'SVO triples', 'script': 'import json\nfrom Orange.data import Domain, StringVariable, Table\n\ntags = in_data.domain["POS Tags"]\nsentence = in_data.domain.metas[0]\nrows = []\nfor doc in in_data:\n    tokens = json.loads(str(doc[tags]))\n    for i, t in enumerate(tokens):\n        if t["dep"].lower() != "root":\n            continue\n        children = lambda labels: [tokens[j]["text"] for j, u in enumerate(tokens)\n                                   if j + u["head"] == i and j != i and u["dep"] in labels]\n        subject = children(("nsubj", "nsubj:pass", "nsubjpass"))\n        obj = children(("dobj", "obj"))\n        if subject and obj:\n            rows.append([str(doc[sentence]), subject[0], t["text"], obj[0]])\n\ndomain = Domain([], metas=[StringVariable(n) for n in ("Sentence", "Subject", "Verb", "Object")])\nout_data = Table.from_list(domain, rows)\n', 'filename': None}], 'scriptText': 'import json\nfrom Orange.data import Domain, StringVariable, Table\n\ntags = in_data.domain["POS Tags"]\nsentence = in_data.domain.metas[0]\nrows = []\nfor doc in in_data:\n    tokens = json.loads(str(doc[tags]))\n    for i, t in enumerate(tokens):\n        if t["dep"].lower() != "root":\n            continue\n        children = lambda labels: [tokens[j]["text"] for j, u in enumerate(tokens)\n                                   if j + u["head"] == i and j != i and u["dep"] in labels]\n        subject = children(("nsubj", "nsubj:pass", "nsubjpass"))\n        obj = children(("dobj", "obj"))\n        if subject and obj:\n            rows.append([str(doc[sentence]), subject[0], t["text"], obj[0]])\n\ndomain = Domain([], metas=[StringVariable(n) for n in ("Sentence", "Subject", "Verb", "Object")])\nout_data = Table.from_list(domain, rows)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xac\x00\x00\x00h\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
